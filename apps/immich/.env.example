# Версия официальных образов Immich. Перед обновлением создайте backup.
# Official Immich image version. Create a backup before updating.
IMMICH_VERSION=v3.1.0

# Порт доступен только локально. Для публикации используйте reverse proxy.
# Local-only port. Use a reverse proxy for public access.
IMMICH_PORT=2283

# Каталог на хосте с оригиналами, превью, транскодами и дампами базы.
# Укажите абсолютный путь на диске с запасом места, например /srv/immich/library.
# Host directory with originals, thumbnails, transcodes, and database dumps.
# Use an absolute path on a disk with free space, for example /srv/immich/library.
IMMICH_UPLOAD_LOCATION=./library

# Docker volume с данными PostgreSQL. Не заменяйте его сетевой файловой системой.
# Docker volume with the PostgreSQL data. Do not move it to a network share.
IMMICH_DB_VOLUME=immich-database

# Docker volume с кэшем моделей машинного обучения. Восстанавливается загрузкой.
# Docker volume with the machine learning model cache. It can be re-downloaded.
IMMICH_MODEL_CACHE_VOLUME=immich-model-cache

# Пользователь и имя базы данных. Меняйте только до первого запуска.
# Database user and name. Change them only before the first start.
IMMICH_DB_USERNAME=immich
IMMICH_DB_DATABASE_NAME=immich

# ОБЯЗАТЕЛЬНО замените перед первым запуском: openssl rand -hex 24
# Upstream допускает только символы A-Za-z0-9 без пробелов.
# REPLACE THIS before the first start: openssl rand -hex 24
# Upstream allows only A-Za-z0-9 characters, without spaces.
IMMICH_DB_PASSWORD=change-me-before-the-first-start

# Часовой пояс в формате IANA, например Etc/UTC.
# IANA time zone, for example Etc/UTC.
TZ=Etc/UTC
