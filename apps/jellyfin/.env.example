# Версия официального Docker-образа. Перед обновлением создайте backup.
# Official image version. Create a backup before updating.
JELLYFIN_VERSION=10.11.11

# Порт доступен только локально. Для публикации используйте reverse proxy.
# Local-only port. Use a reverse proxy for public access.
JELLYFIN_PORT=8096

# Внешний адрес сервера: его Jellyfin отдаёт клиентам и использует в autodiscovery.
# External server address announced to clients and used by autodiscovery.
JELLYFIN_PUBLISHED_URL=http://127.0.0.1:8096

# Каталог на хосте с медиатекой. Подключается только для чтения.
# Укажите абсолютный путь, например /srv/media.
# Host directory with the media library. It is mounted read-only.
# Use an absolute path, for example /srv/media.
JELLYFIN_MEDIA_LOCATION=./media

# Docker volume с настройками, базой, метаданными и пользователями.
# Docker volume with settings, database, metadata, and users.
JELLYFIN_CONFIG_VOLUME=jellyfin-config

# Docker volume с кэшем и превью. Восстанавливается повторным сканированием.
# Docker volume with cache and thumbnails. It is rebuilt by a library rescan.
JELLYFIN_CACHE_VOLUME=jellyfin-cache

# Часовой пояс в формате IANA, например Etc/UTC.
# IANA time zone, for example Etc/UTC.
TZ=Etc/UTC
