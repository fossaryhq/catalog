NETDATA_VERSION=2.12.2
NETDATA_PORT=19999
NETDATA_HOSTNAME=metrics-server
NETDATA_AUTH_USER=admin
# Generate interactively: docker run --rm -it caddy:2.11.7-alpine caddy hash-password
# Keep the single quotes: bcrypt hashes contain dollar signs.
NETDATA_AUTH_HASH='replace-with-bcrypt-hash'
TZ=Etc/UTC
