# Локальный web-порт; Compose всегда привязывает его к 127.0.0.1.
# Local web port; Compose always binds it to 127.0.0.1.
ACTUAL_PORT=5006

# Способ входа: password, openid или header. Меняйте только вместе со списком
# разрешённых способов ниже.
# Login method: password, openid, or header. Change it only together with the
# list of allowed methods below.
ACTUAL_LOGIN_METHOD=password

# Разрешённые способы входа через запятую. Пока в списке только password, вход
# по заголовку и OpenID закрыты, даже если прокси подставит заголовок.
# Comma-separated list of permitted login methods. While it holds password
# only, header and OpenID logins stay closed even if a proxy sets the header.
ACTUAL_ALLOWED_LOGIN_METHODS=password

# Пределы размера файлов синхронизации в МБ.
# Sync file size limits in MB.
ACTUAL_UPLOAD_FILE_SYNC_SIZE_LIMIT_MB=20
ACTUAL_UPLOAD_SYNC_ENCRYPTED_FILE_SYNC_SIZE_LIMIT_MB=50
ACTUAL_UPLOAD_FILE_SIZE_LIMIT_MB=20

# Часовой пояс IANA.
# IANA time zone.
ACTUAL_TIME_ZONE=Etc/UTC

# Имя постоянного volume: в нём server-files и user-files, то есть весь бюджет.
# Persistent volume name: it holds server-files and user-files, the whole budget.
ACTUAL_DATA_VOLUME=actual-data

# Каталог локальных архивов; копируйте их за пределы сервера и шифруйте.
# Local archive directory; encrypt backups and copy them off the server.
ACTUAL_BACKUP_DIR=./backups
