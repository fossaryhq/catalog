# Версия официального Docker-образа. Перед обновлением создайте backup.
# Official image version. Create a backup before updating.
GATUS_VERSION=v5.36.0

# Порт доступен только локально. Для публикации используйте reverse proxy.
# Local-only port. Use a reverse proxy for public access.
GATUS_PORT=8080

# Docker volume с SQLite-базой и историей проверок.
# Docker volume containing the SQLite database and check history.
GATUS_DATA_VOLUME=gatus-data

# Каталог с config.yaml. Относительный путь считается от compose.yaml.
# Directory containing config.yaml. Relative paths start at compose.yaml.
GATUS_CONFIG_DIR=./config

# Имя пользователя панели. Замените перед первым запуском.
# Dashboard username. Replace before the first start.
GATUS_USERNAME=change-me

# Bcrypt-хеш пароля в Base64. Замените placeholder перед запуском.
# Base64-encoded bcrypt password hash. Replace the placeholder before starting.
GATUS_PASSWORD_BCRYPT_BASE64=replace-with-base64-bcrypt-hash
