# Pin releases from https://github.com/mealie-recipes/mealie/releases.
MEALIE_VERSION=v3.29.0
# The panel is bound to loopback by default. Keep it behind a trusted proxy.
MEALIE_PORT=9925
# Set this to the public HTTPS URL when enabling email or OIDC callbacks.
MEALIE_BASE_URL=http://localhost:9925
# The official container uses these IDs for files under /app/data.
PUID=1000
PGID=1000
TZ=Etc/UTC
# Initial interface language: en or ru.
MEALIE_DEFAULT_LOCALE=en
# Persistent SQLite database, uploads, and application data.
MEALIE_DATA_VOLUME=mealie-data
