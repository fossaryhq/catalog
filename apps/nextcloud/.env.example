# Версия официального Docker-образа. Перед обновлением создайте backup.
# Official image version. Create a backup before updating.
NEXTCLOUD_VERSION=34.0.3

# Порт доступен только локально. Для публикации используйте reverse proxy.
# Local-only port. Use a reverse proxy for public access.
NEXTCLOUD_PORT=8080

# Каталог на хосте с файлами пользователей. Растёт вместе с облаком.
# Укажите абсолютный путь, например /srv/nextcloud/data.
# Host directory with user files. It grows together with the cloud.
# Use an absolute path, for example /srv/nextcloud/data.
NEXTCLOUD_DATA_LOCATION=./data

# Docker volume с кодом, приложениями и config.php.
# Docker volume with the code, apps, and config.php.
NEXTCLOUD_HTML_VOLUME=nextcloud-html

# Docker volume с данными PostgreSQL.
# Docker volume with the PostgreSQL data.
NEXTCLOUD_DB_VOLUME=nextcloud-database

# Доступ к базе. Меняйте пользователя и имя только до первого запуска.
# Database access. Change the user and name only before the first start.
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud

# ОБЯЗАТЕЛЬНО замените перед первым запуском: openssl rand -hex 24
# REPLACE THIS before the first start: openssl rand -hex 24
NEXTCLOUD_DB_PASSWORD=change-me-before-the-first-start

# Учётная запись администратора создаётся при первом запуске.
# ОБЯЗАТЕЛЬНО замените пароль: openssl rand -base64 24
# The administrator account is created on the first start.
# REPLACE the password: openssl rand -base64 24
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-before-the-first-start

# Домены, с которых разрешён вход. Через пробел, например: cloud.example.com localhost
# Domains allowed to serve the instance, space separated.
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# Заполняются при публикации через reverse proxy.
# TRUSTED_PROXIES — адрес или подсеть proxy, OVERWRITE* — внешняя схема и URL.
# Filled in when publishing behind a reverse proxy.
NEXTCLOUD_TRUSTED_PROXIES=
NEXTCLOUD_OVERWRITE_PROTOCOL=
NEXTCLOUD_OVERWRITE_CLI_URL=

# Лимиты PHP: память процесса и максимальный размер загружаемого файла.
# PHP limits: process memory and maximum upload size.
NEXTCLOUD_PHP_MEMORY_LIMIT=512M
NEXTCLOUD_PHP_UPLOAD_LIMIT=10G

# Часовой пояс в формате IANA, например Etc/UTC.
# IANA time zone, for example Etc/UTC.
TZ=Etc/UTC
