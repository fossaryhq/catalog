# Pinned official Node-RED image. The -24 variant runs on Node.js 24.
NODE_RED_VERSION=5.0.8-24

# The editor listens only on this host. Publish it through a reverse proxy for
# Internet access, or use an SSH tunnel.
NODE_RED_PORT=1880

# Editor credentials. Create the bcrypt value with:
# docker run --rm -it nodered/node-red:5.0.8-24 node-red admin hash-pw
# Never use a plain password here and keep .env mode 600.
NODE_RED_ADMIN_USERNAME=admin
NODE_RED_ADMIN_PASSWORD_HASH=change-me-before-the-first-start

# Encrypts saved credentials. Generate once with: openssl rand -hex 32
# Do not change it after creating credentials; store it with encrypted backups.
NODE_RED_CREDENTIAL_SECRET=change-me-before-the-first-start

# Named volume containing flows, credentials, installed nodes, and settings.
NODE_RED_DATA_VOLUME=node-red-data
NODE_RED_SETTINGS_FILE=./config/settings.js

# IANA time zone used by time-related nodes.
TZ=Etc/UTC
