# Версия официального Docker-образа. Стабильная линия — 2.36.x;
# теги 2.37.x на Docker Hub относятся к beta-каналу.
# Official image version. The stable line is 2.36.x;
# 2.37.x tags on Docker Hub belong to the beta channel.
N8N_VERSION=2.36.9

# Порт доступен только локально. Для публикации используйте reverse proxy.
# Local-only port. Use a reverse proxy for public access.
N8N_PORT=5678

# ОБЯЗАТЕЛЬНО замените перед первым запуском: openssl rand -hex 32
# Этим ключом шифруются пароли и токены всех подключённых сервисов.
# После первого запуска ключ менять нельзя — доступы станут нечитаемыми.
# REPLACE THIS before the first start: openssl rand -hex 32
# This key encrypts the passwords and tokens of every connected service.
# Never change it after the first start: existing credentials become unreadable.
N8N_ENCRYPTION_KEY=change-me-before-the-first-start

# Доступ к базе. Меняйте пользователя и имя только до первого запуска.
# Database access. Change the user and name only before the first start.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n

# ОБЯЗАТЕЛЬНО замените перед первым запуском: openssl rand -hex 24
# REPLACE THIS before the first start: openssl rand -hex 24
N8N_DB_PASSWORD=change-me-before-the-first-start

# Внешнее имя хоста и схема. Нужны вебхукам и ссылкам из интерфейса.
# External host name and scheme. Needed by webhooks and links in the UI.
N8N_PUBLIC_HOST=localhost
N8N_PROTOCOL=http

# Полный внешний URL при публикации через reverse proxy,
# например https://n8n.example.com/. Пустое значение — доступ только локальный.
# Full external URL when publishing behind a reverse proxy,
# for example https://n8n.example.com/. Empty means local access only.
N8N_WEBHOOK_URL=

# Cookie сессии отдаётся только по HTTPS или на localhost. Поставьте false,
# только если открываете интерфейс по HTTP внутри доверенной сети.
# The session cookie is sent over HTTPS or on localhost only. Set false only
# when you open the UI over plain HTTP inside a trusted network.
N8N_SECURE_COOKIE=true

# Число reverse proxy перед n8n. Влияет на определение IP клиента.
# Number of reverse proxies in front of n8n. Affects client IP detection.
N8N_PROXY_HOPS=0

# Телеметрия и проверка новых версий. По умолчанию выключены.
# Telemetry and version notifications. Disabled by default.
N8N_DIAGNOSTICS=false
N8N_VERSION_NOTIFICATIONS=false

# Сколько часов хранится история выполнений. 336 часов — две недели.
# How many hours the execution history is kept. 336 hours is two weeks.
N8N_EXECUTIONS_MAX_AGE_HOURS=336

# Docker volume с ключом шифрования, настройками и бинарными данными.
# Docker volume with the encryption key, settings, and binary data.
N8N_DATA_VOLUME=n8n-data

# Docker volume с данными PostgreSQL: процессы, учётные данные, выполнения.
# Docker volume with the PostgreSQL data: workflows, credentials, executions.
N8N_DB_VOLUME=n8n-database

# Часовой пояс в формате IANA, например Etc/UTC.
# IANA time zone, for example Etc/UTC.
TZ=Etc/UTC
