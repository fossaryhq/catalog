# BookStack release; the LinuxServer tag adds the version- prefix.
BOOKSTACK_VERSION=v26.09.2
BOOKSTACK_PORT=6875
# Must exactly match the address used by your browser, including scheme and port.
BOOKSTACK_APP_URL=http://localhost:6875
# Generate once: printf 'base64:'; openssl rand -base64 32
BOOKSTACK_APP_KEY=base64:replace-with-output-of-openssl-rand-base64-32
# Generate each independently with: openssl rand -hex 32
BOOKSTACK_DB_PASSWORD=replace-with-a-unique-random-database-password
BOOKSTACK_DB_ROOT_PASSWORD=replace-with-a-different-random-root-password
PUID=1000
PGID=1000
TZ=Etc/UTC
BOOKSTACK_CONFIG_VOLUME=bookstack-config
BOOKSTACK_DB_VOLUME=bookstack-database
# Optional host backup location; leave unset to use ./backups.
# BOOKSTACK_BACKUP_DIR=/absolute/path/to/backups
