# Локальный web-порт; Compose всегда привязывает его к 127.0.0.1.
# Local web port; Compose always binds it to 127.0.0.1.
FRESHRSS_PORT=8080

# Точный внешний URL без завершающего слеша; предпочтителен отдельный поддомен.
# Exact public URL without a trailing slash; a dedicated subdomain is preferred.
FRESHRSS_BASE_URL=https://rss.example.com

# ASCII-alphanumeric логин администратора; меняется только до первого запуска.
# ASCII-alphanumeric administrator login; change only before the first start.
FRESHRSS_ADMIN_USER=freshrssadmin

# Обязательные независимые пароли web-входа и API: openssl rand -hex 24
# Required independent web login and API passwords: openssl rand -hex 24
FRESHRSS_ADMIN_PASSWORD=CHANGE_ME_WITH_A_RANDOM_LOGIN_PASSWORD
FRESHRSS_ADMIN_API_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_API_PASSWORD

# Email администратора, используемый при детерминированном первом запуске.
# Administrator email used during deterministic first-run initialization.
FRESHRSS_ADMIN_EMAIL=admin@example.com

# Обязательный отдельный пароль PostgreSQL: openssl rand -hex 24
# Required independent PostgreSQL password: openssl rand -hex 24
FRESHRSS_DB_PASSWORD=CHANGE_ME_WITH_A_RANDOM_DATABASE_PASSWORD

# Имя базы и роли PostgreSQL. Меняйте только до первого запуска.
# PostgreSQL database and role names. Change only before the first start.
FRESHRSS_DB_NAME=freshrss
FRESHRSS_DB_USER=freshrss

# Часовой пояс IANA и безопасные минуты встроенного cron (дважды в час).
# IANA time zone and safe built-in cron minutes (twice per hour).
FRESHRSS_TIME_ZONE=Etc/UTC
FRESHRSS_CRON_MIN=13,43

# 0 запрещает доверять forwarded client-IP и external-auth заголовкам.
# 0 disables trust in forwarded client-IP and external-auth headers.
FRESHRSS_TRUSTED_PROXY=0

# Имена постоянных volumes для данных, расширений и PostgreSQL.
# Persistent volume names for data, extensions, and PostgreSQL.
FRESHRSS_DATA_VOLUME=freshrss-data
FRESHRSS_EXTENSIONS_VOLUME=freshrss-extensions
FRESHRSS_DB_VOLUME=freshrss-database

# Каталог локальных архивов; обязательно копируйте их за пределы сервера.
# Local archive directory; always copy backups off the server.
FRESHRSS_BACKUP_DIR=./backups
