# Локальный web-порт Gitea. Публикуйте web только через HTTPS reverse proxy.
# Local Gitea web port. Expose the web UI only through an HTTPS reverse proxy.
GITEA_HTTP_PORT=3000

# Локальный SSH-порт. Compose привязывает его к 127.0.0.1 по умолчанию.
# Local SSH port. Compose binds it to 127.0.0.1 by default.
GITEA_SSH_PORT=2222

# Публичные домены web и SSH. Обычно это один домен.
# Public web and SSH domains. They are usually the same domain.
GITEA_DOMAIN=git.example.com
GITEA_SSH_DOMAIN=git.example.com

# Внешний HTTPS URL с завершающим слешем.
# External HTTPS URL with a trailing slash.
GITEA_ROOT_URL=https://git.example.com/

# Замените значение длинным случайным паролем: openssl rand -base64 36
# Replace this value with a long random password: openssl rand -base64 36
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_RANDOM_PASSWORD

# Имя базы и роли PostgreSQL.
# PostgreSQL database and role names.
POSTGRES_DB=gitea
POSTGRES_USER=gitea

# Имена постоянных Docker volumes.
# Persistent Docker volume names.
GITEA_DATA_VOLUME=gitea-data
GITEA_DB_VOLUME=gitea-database

# Каталог локальных копий; шифруйте и копируйте его за пределы сервера.
# Local backup directory; encrypt it and copy it off the server.
GITEA_BACKUP_DIR=./backups
