KARAKEEP_VERSION=0.34.1
KARAKEEP_PORT=3000
KARAKEEP_URL=http://localhost:3000
KARAKEEP_AUTH_SECRET=replace-with-openssl-rand-hex-32
KARAKEEP_MEILI_KEY=replace-with-another-openssl-rand-hex-32
KARAKEEP_DISABLE_SIGNUPS=true
TZ=Etc/UTC
# Optional absolute directory; empty uses ./backups.
KARAKEEP_BACKUP_DIR=
