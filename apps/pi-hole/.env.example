# Pinned official Docker image tag. Back up before changing it.
# Закреплённый тег официального образа. Сделайте backup перед обновлением.
PIHOLE_VERSION=2026.09.0

# Set a long, unique password before the first start. The sample value is not
# safe for use. Quote shell-special characters when editing the file.
# До первого запуска задайте длинный уникальный пароль. Пример небезопасен.
PIHOLE_WEB_PASSWORD=replace-with-a-long-unique-password

# DNS bind address: localhost by default. Use the server's specific LAN or VPN
# interface address for clients, never a public address or 0.0.0.0.
# Адрес DNS: по умолчанию localhost. Для клиентов укажите конкретный адрес LAN
# или VPN-интерфейса, но не публичный адрес и не 0.0.0.0.
PIHOLE_DNS_BIND=127.0.0.1

# Published DNS port. Ordinary DNS clients expect 53.
# Внешний порт DNS. Обычные клиенты ожидают порт 53.
PIHOLE_DNS_PORT=53

# Host-only web panel port; the container itself listens on port 80.
# Локальный порт панели; внутри контейнера используется порт 80.
PIHOLE_WEB_PORT=8080

# Docker volume with pihole.toml, gravity.db, the query database, and lists.
# Docker volume с pihole.toml, gravity.db, журналом запросов и списками.
PIHOLE_VOLUME=pi-hole-data

# IANA time zone for schedules and statistics.
# Часовой пояс IANA для расписаний и статистики.
TZ=Etc/UTC
