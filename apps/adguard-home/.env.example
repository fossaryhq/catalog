# Версия официального Docker-образа. Теги AdGuard Home содержат префикс "v".
# Перед обновлением создайте backup.
# Official image version. AdGuard Home tags carry a "v" prefix.
# Create a backup before updating.
ADGUARD_VERSION=v0.107.79

# Адрес, на котором публикуется DNS. По умолчанию только localhost.
# Для доверенной LAN укажите конкретный адрес сервера, например 192.168.1.10.
# Не используйте 0.0.0.0: открытый в интернет резолвер служит для DNS-амплификации.
# Address the DNS ports are published on. Localhost only by default.
# For a trusted LAN use the server address, for example 192.168.1.10.
# Never use 0.0.0.0: an internet-facing resolver is abused for DNS amplification.
ADGUARD_DNS_BIND=127.0.0.1

# Внешний порт DNS. Меняйте, только если 53 занят и клиенты умеют другой порт.
# Published DNS port. Change it only if 53 is taken and clients support it.
ADGUARD_DNS_PORT=53

# Порт веб-панели. Публикуется только на 127.0.0.1, наружу — через reverse proxy.
# Web UI port. Published on 127.0.0.1 only; expose it through a reverse proxy.
ADGUARD_WEB_PORT=3000

# Docker volume с AdGuardHome.yaml: пользователи, upstream-серверы, правила.
# Docker volume holding AdGuardHome.yaml: users, upstreams, custom rules.
ADGUARD_CONF_VOLUME=adguard-home-conf

# Docker volume со статистикой, журналом запросов и скачанными блок-листами.
# Docker volume holding statistics, the query log, and downloaded blocklists.
ADGUARD_WORK_VOLUME=adguard-home-work

# Часовой пояс в формате IANA, например Etc/UTC.
# IANA time zone, for example Etc/UTC.
TZ=Etc/UTC
