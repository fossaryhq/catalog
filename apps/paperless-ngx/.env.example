# Локальный web-порт; Compose всегда привязывает его к 127.0.0.1.
# Local web port; Compose always binds it to 127.0.0.1.
PAPERLESS_PORT=8000

# Внешний URL без завершающего слеша и без подкаталога.
# Public URL without a trailing slash or subpath.
PAPERLESS_URL=https://paperless.example.com

# Обязательный ключ подписи сессий: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Required session signing key: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Обязательный случайный пароль PostgreSQL: openssl rand -hex 32
# Required random PostgreSQL password: openssl rand -hex 32
PAPERLESS_DB_PASSWORD=CHANGE_ME_WITH_A_RANDOM_PASSWORD

# Имя базы и роли PostgreSQL. Меняйте только до первого запуска.
# PostgreSQL database and role names. Change only before the first start.
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless

# Часовой пояс приложения в формате IANA.
# Application time zone in IANA format.
PAPERLESS_TIME_ZONE=Etc/UTC

# Языки OCR. OCR_LANGUAGE — что распознавать (`rus+eng`), OCR_LANGUAGES — какие
# пакеты tesseract доустановить при старте (`rus deu`); eng встроен в образ.
# OCR languages. OCR_LANGUAGE is what to recognize (`rus+eng`), OCR_LANGUAGES is
# which tesseract packs to install at start (`rus deu`); eng ships in the image.
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_LANGUAGES=eng

# Имена постоянных volumes приложения, документов, export, consume, БД и broker.
# Persistent volume names for app data, documents, export, consume, DB, and broker.
PAPERLESS_DATA_VOLUME=paperless-data
PAPERLESS_MEDIA_VOLUME=paperless-media
PAPERLESS_EXPORT_VOLUME=paperless-export
PAPERLESS_CONSUME_VOLUME=paperless-consume
PAPERLESS_DB_VOLUME=paperless-database
PAPERLESS_BROKER_VOLUME=paperless-broker

# Каталог локальных архивов; обязательно копируйте их за пределы сервера.
# Local archive directory; always copy backups off the server.
PAPERLESS_BACKUP_DIR=./backups
