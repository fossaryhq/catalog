# Версия официального Docker-образа. Перед обновлением создайте backup.
# Official image version. Create a backup before updating.
VAULTWARDEN_VERSION=1.37.2

# Порт доступен только локально. Для публикации используйте HTTPS reverse proxy.
# Local-only port. Use an HTTPS reverse proxy for public access.
VAULTWARDEN_PORT=8000

# Внешний HTTPS URL без завершающего слеша. Он должен совпадать с доменом proxy.
# External HTTPS URL without a trailing slash. It must match the proxy domain.
VAULTWARDEN_DOMAIN=https://vault.example.com

# Включайте регистрацию только временно для создания нужных учётных записей.
# Enable registration only temporarily to create the required accounts.
VAULTWARDEN_SIGNUPS_ALLOWED=false

# Владельцы организаций не могут приглашать новых пользователей при false.
# Organization owners cannot invite new users when set to false.
VAULTWARDEN_INVITATIONS_ALLOWED=false

# Docker volume с SQLite, вложениями, ключами и конфигурацией.
# Docker volume containing SQLite, attachments, keys, and configuration.
VAULTWARDEN_DATA_VOLUME=vaultwarden-data

# Часовой пояс в формате IANA, например Etc/UTC.
# IANA time zone, for example Etc/UTC.
TZ=Etc/UTC
