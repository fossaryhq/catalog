# Версия официального образа PhotoPrism. Перед обновлением создайте backup.
# Official PhotoPrism image version. Create a backup before updating.
PHOTOPRISM_VERSION=260728

# Локальный web-порт. Публичный доступ настраивается только через reverse proxy.
# Local web port. Configure public access only through a reverse proxy.
PHOTOPRISM_PORT=2342

# Внешний URL с завершающим слешем. Для домена используйте https://photos.example.com/
# Public URL with a trailing slash. For a domain, use https://photos.example.com/
PHOTOPRISM_SITE_URL=http://localhost:2342/

# Имя администратора и ОБЯЗАТЕЛЬНЫЙ случайный пароль длиной 8-72 символа.
# Admin username and REQUIRED random password between 8 and 72 characters.
PHOTOPRISM_ADMIN_USER=admin
PHOTOPRISM_ADMIN_PASSWORD=change-me-before-the-first-start

# Язык интерфейса по умолчанию: en, ru и другие поддерживаемые локали.
# Default interface language: en, ru, or another supported locale.
PHOTOPRISM_DEFAULT_LOCALE=en

# Каталоги оригиналов и изменяемых данных: превью, sidecar, кэш и dumps.
# Original media and writable data directories: previews, sidecars, cache, dumps.
PHOTOPRISM_ORIGINALS_PATH=./originals
PHOTOPRISM_STORAGE_PATH=./storage

# UID и GID, под которыми образ запускает сервер: init стартует от root и
# сбрасывает привилегии через setpriv. Каталоги выше должны принадлежать этому
# пользователю, иначе PhotoPrism не сможет в них писать: id -u; id -g.
# UID and GID the image runs the server as: init starts as root and drops
# privileges with setpriv. The directories above must be owned by this user,
# otherwise PhotoPrism cannot write to them: id -u; id -g.
PHOTOPRISM_UID=1000
PHOTOPRISM_GID=1000

# Каталог локальных копий; шифруйте его и храните копию вне сервера.
# Local backup directory; encrypt it and keep a copy off the server.
PHOTOPRISM_BACKUP_DIR=./backups

# Пусто по умолчанию. Значение `tensorflow` при каждом пересоздании контейнера
# качает ~500 МБ с dl.photoprism.app и до конца загрузки не поднимает web-сервер;
# в образе уже есть TensorFlow, оптимизация лишь ускоряет распознавание.
# Empty by default. Setting `tensorflow` downloads ~500 MB from dl.photoprism.app
# on every container re-creation and delays the web server until it finishes;
# the image already ships TensorFlow and this only speeds up classification.
PHOTOPRISM_INIT=

# Имя базы, пользователь и ОБЯЗАТЕЛЬНЫЕ разные случайные пароли.
# Database name, user, and REQUIRED distinct random passwords.
PHOTOPRISM_DATABASE_NAME=photoprism
PHOTOPRISM_DATABASE_USER=photoprism
PHOTOPRISM_DATABASE_PASSWORD=change-me-before-the-first-start
PHOTOPRISM_DATABASE_ROOT_PASSWORD=change-me-before-the-first-start

# Имя Docker volume с файлами MariaDB. Меняйте только до первого запуска.
# Docker volume containing MariaDB files. Change only before first start.
PHOTOPRISM_DATABASE_VOLUME=photoprism-database

# Часовой пояс IANA для дат и расписания backup.
# IANA time zone for dates and the backup schedule.
TZ=Etc/UTC
