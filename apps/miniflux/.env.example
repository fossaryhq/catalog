# Локальный web-порт; Compose всегда привязывает его к 127.0.0.1.
# Local web port; Compose always binds it to 127.0.0.1.
MINIFLUX_PORT=8080

# Точный внешний адрес без завершающего слеша: по нему строятся ссылки,
# OAuth2-редиректы и адрес Google Reader API.
# Exact public URL without a trailing slash: links, OAuth2 redirects, and the
# Google Reader API endpoint are built from it.
MINIFLUX_BASE_URL=https://reader.example.com

# Первая учётная запись создаётся при первом старте. Пароль обязателен и должен
# состоять минимум из 12 символов без пробелов.
# The first account is created on the first start. The password is required and
# must be at least 12 characters long, without spaces.
MINIFLUX_ADMIN_USER=minifluxadmin
MINIFLUX_ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# Пароль PostgreSQL попадает внутрь DATABASE_URL, поэтому только буквы и цифры:
# openssl rand -hex 32
# The PostgreSQL password goes inside DATABASE_URL, so keep it alphanumeric:
# openssl rand -hex 32
MINIFLUX_DB_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_ALPHANUMERIC_PASSWORD

# Имя базы и роли. Меняйте только до первого запуска.
# Database and role names. Change only before the first start.
MINIFLUX_DB_NAME=miniflux
MINIFLUX_DB_USER=miniflux

# Как часто фоновый сборщик опрашивает ленты, в минутах.
# How often the background collector polls feeds, in minutes.
MINIFLUX_POLLING_FREQUENCY=60

# Сколько подряд идущих ошибок разбора отключают ленту.
# How many consecutive parsing errors disable a feed.
MINIFLUX_POLLING_PARSING_ERROR_LIMIT=3

# Через сколько дней прочитанные записи уходят в архив и удаляются.
# After how many days read entries are archived and removed.
MINIFLUX_CLEANUP_ARCHIVE_READ_DAYS=60

# Список CIDR доверенного обратного прокси. По умолчанию только loopback, то
# есть заголовкам от моста Docker не доверяют. Пустым оставлять нельзя.
# Trusted reverse-proxy CIDR list. Loopback only by default, so headers coming
# over the Docker bridge are not trusted. It must never be left empty.
MINIFLUX_TRUSTED_PROXY_NETWORKS=127.0.0.1/8

# Уровень журналирования: error, warning, info или debug.
# Log level: error, warning, info, or debug.
MINIFLUX_LOG_LEVEL=info

# Часовой пояс IANA для приложения и PostgreSQL.
# IANA time zone for the application and PostgreSQL.
MINIFLUX_TIME_ZONE=Etc/UTC

# Имя постоянного volume с базой: единственное состояние рецепта.
# Name of the persistent database volume: the only state this recipe keeps.
MINIFLUX_DB_VOLUME=miniflux-database

# Каталог локальных архивов; копируйте их за пределы сервера и шифруйте.
# Local archive directory; encrypt backups and copy them off the server.
MINIFLUX_BACKUP_DIR=./backups
