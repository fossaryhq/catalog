# Локальный web-порт; Compose всегда привязывает его к 127.0.0.1.
# Local web port; Compose always binds it to 127.0.0.1.
LINKWARDEN_PORT=3000

# Точный внешний URL основного приложения без завершающего слеша.
# Exact public application URL without a trailing slash.
LINKWARDEN_URL=https://links.example.com

# Отдельный HTTPS origin для сохранённого HTML, не разделяющий cookies приложения.
# Separate HTTPS origin for preserved HTML that does not share application cookies.
LINKWARDEN_USER_CONTENT_URL=https://saved.example.net

# После создания первой учётной записи немедленно замените false на true.
# Change false to true immediately after creating the first account.
NEXT_PUBLIC_DISABLE_REGISTRATION=false

# Три обязательных независимых URL-safe секрета: openssl rand -hex 32
# Three required independent URL-safe secrets: openssl rand -hex 32
NEXTAUTH_SECRET=CHANGE_ME_WITH_A_RANDOM_NEXTAUTH_SECRET
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_DATABASE_PASSWORD
MEILI_MASTER_KEY=CHANGE_ME_WITH_A_DIFFERENT_MEILI_MASTER_KEY

# Имя базы и роли PostgreSQL. Меняйте только до первого запуска.
# PostgreSQL database and role names. Change only before the first start.
POSTGRES_DB=linkwarden
POSTGRES_USER=linkwarden

# Часовой пояс IANA для приложения и PostgreSQL.
# IANA time zone for the application and PostgreSQL.
LINKWARDEN_TIME_ZONE=Etc/UTC

# Имена постоянных volumes для архивов, PostgreSQL и поискового индекса.
# Persistent volume names for archives, PostgreSQL, and the search index.
LINKWARDEN_DATA_VOLUME=linkwarden-data
LINKWARDEN_DB_VOLUME=linkwarden-postgres
LINKWARDEN_MEILI_VOLUME=linkwarden-meilisearch

# Каталог локальных архивов; обязательно копируйте их за пределы сервера.
# Local archive directory; always copy backups off the server.
LINKWARDEN_BACKUP_DIR=./backups
