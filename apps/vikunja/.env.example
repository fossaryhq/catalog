VIKUNJA_VERSION=2.7.1
VIKUNJA_PORT=3456
VIKUNJA_PUBLIC_URL=http://localhost:3456/
VIKUNJA_SECRET=replace-with-output-of-openssl-rand-hex-32
VIKUNJA_DB_PASSWORD=replace-with-a-different-random-database-password
VIKUNJA_DB_VOLUME=vikunja-database
VIKUNJA_DATA_VOLUME=vikunja-data
TZ=Etc/UTC
# Optional absolute directory for protected backup archives:
# VIKUNJA_BACKUP_DIR=/absolute/path/to/backups
