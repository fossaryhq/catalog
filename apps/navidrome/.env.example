# Версия официального Docker-образа. Перед обновлением создайте backup.
# Official image version. Create a backup before updating.
NAVIDROME_VERSION=0.63.2

# Порт доступен только локально. Для публикации используйте reverse proxy.
# Local-only port. Use a reverse proxy for public access.
NAVIDROME_PORT=4533

# Каталог на хосте с музыкой. Подключается только для чтения.
# Укажите абсолютный путь, например /srv/music.
# Host directory with the music library. It is mounted read-only.
# Use an absolute path, for example /srv/music.
NAVIDROME_MUSIC_LOCATION=./music

# Docker volume с базой, настройками, обложками и историей прослушиваний.
# Docker volume with the database, settings, artwork cache, and play history.
NAVIDROME_DATA_VOLUME=navidrome-data

# Как часто пересканировать медиатеку. Пустое значение отключает автоскан.
# How often the library is rescanned. An empty value disables automatic scans.
NAVIDROME_SCAN_INTERVAL=24h

# Уровень логирования: error, info, debug, trace.
# Log level: error, info, debug, trace.
NAVIDROME_LOG_LEVEL=info

# Через сколько бездействия завершается сессия в веб-интерфейсе.
# How long an idle web session stays open.
NAVIDROME_SESSION_TIMEOUT=24h

# Подкаталог, если Navidrome публикуется не в корне домена, например /music.
# Subpath when Navidrome is published below the domain root, for example /music.
NAVIDROME_BASE_URL=

# Отправка анонимной статистики разработчикам. В рецепте выключена.
# Anonymous usage statistics sent to the developers. Disabled in this recipe.
NAVIDROME_INSIGHTS=false

# Часовой пояс в формате IANA, например Etc/UTC.
# IANA time zone, for example Etc/UTC.
TZ=Etc/UTC
