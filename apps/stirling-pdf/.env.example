# Локальный web-порт; Compose всегда привязывает его к 127.0.0.1.
# Local web port; Compose always binds it to 127.0.0.1.
STIRLING_PDF_PORT=8080

# Единственный внешний origin без завершающего слеша и пути.
# Sole public origin without a trailing slash or path.
STIRLING_PDF_URL=https://pdf.example.com

# Каталог с configs/H2, custom files, pipeline и OCR-данными.
# Directory containing configs/H2, custom files, pipeline, and OCR data.
STIRLING_PDF_DATA_PATH=./data

# Начальный администратор. Замените оба значения до первого запуска.
# Initial administrator. Replace both values before the first start.
STIRLING_PDF_INITIAL_USERNAME=pdf-admin
STIRLING_PDF_INITIAL_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# Локаль интерфейса по умолчанию, например en-GB, ru-RU, de-DE.
# Default UI locale, for example en-GB, ru-RU, de-DE. Each user can pick another.
STIRLING_PDF_DEFAULT_LOCALE=en-GB

# Защитный лимит одного запроса и файла в МБ (1-999).
# Defensive per-request and per-file limit in MB (1-999).
STIRLING_PDF_UPLOAD_LIMIT_MB=250

# Каталог локальных архивов; копируйте за пределы сервера и шифруйте.
# Local archive directory; encrypt backups and copy them off the server.
STIRLING_PDF_BACKUP_DIR=./backups
