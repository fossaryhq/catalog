# Локальный web-порт; Compose всегда привязывает его к 127.0.0.1.
# Local web port; Compose always binds it to 127.0.0.1.
SEAFILE_PORT=8000

# Внешнее имя хоста без схемы и слеша и протокол, по которому сервис доступен
# снаружи. Оба значения попадают в ссылки, письма и настройки клиентов.
# Public hostname without scheme or slash, and the protocol the service is
# reachable by. Both end up in links, e-mail, and client settings.
SEAFILE_SERVER_HOSTNAME=files.example.com
SEAFILE_SERVER_PROTOCOL=https

# Первая учётная запись создаётся при первом запуске: адрес и пароль
# администратора. Пароль поменяйте до старта.
# The first account is created on the first start: administrator address and
# password. Change the password before starting.
SEAFILE_ADMIN_EMAIL=admin@example.com
SEAFILE_ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# Три независимых секрета: openssl rand -hex 32 для каждого. JWT-ключ должен
# быть не короче 32 символов.
# Three independent secrets: openssl rand -hex 32 for each. The JWT key must be
# at least 32 characters long.
SEAFILE_DB_ROOT_PASSWORD=CHANGE_ME_WITH_A_RANDOM_MARIADB_ROOT_PASSWORD
SEAFILE_DB_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_DATABASE_PASSWORD
SEAFILE_JWT_PRIVATE_KEY=CHANGE_ME_WITH_A_DIFFERENT_KEY_OF_32_CHARS_OR_MORE

# Пароль кеша Valkey; в сеть он не публикуется, но пустым оставлять нельзя.
# Valkey cache password; it is never published to the network, but it must not
# be left empty.
SEAFILE_CACHE_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_CACHE_PASSWORD

# Имя роли MariaDB. Меняйте только до первого запуска.
# MariaDB role name. Change only before the first start.
SEAFILE_DB_USER=seafile

# Часовой пояс IANA для сервера и базы.
# IANA time zone for the server and the database.
SEAFILE_TIME_ZONE=Etc/UTC

# Имена постоянных volumes: файлы и конфигурация Seafile и данные MariaDB.
# Persistent volume names: Seafile files and configuration, and MariaDB data.
SEAFILE_DATA_VOLUME=seafile-data
SEAFILE_DB_VOLUME=seafile-database

# Каталог локальных архивов; копируйте их за пределы сервера и шифруйте.
# Local archive directory; encrypt backups and copy them off the server.
SEAFILE_BACKUP_DIR=./backups
