# Версия официального Docker-образа. Перед обновлением создайте backup.
# Official image version. Create a backup before updating.
SYNCTHING_VERSION=2.1.3

# Имя устройства, которое увидят остальные узлы.
# Device name shown to the other nodes.
SYNCTHING_DEVICE_NAME=fossary

# Порт веб-интерфейса доступен только локально.
# The web interface port is local-only.
SYNCTHING_GUI_PORT=8384

# Порт синхронизации. Должен быть открыт наружу, иначе устройства
# будут соединяться только через публичные relay и заметно медленнее.
# Sync port. It must be reachable from outside, otherwise devices connect
# only through public relays and noticeably slower.
SYNCTHING_SYNC_PORT=22000

# Порт локального обнаружения устройств в той же сети.
# Local discovery port for devices on the same network.
SYNCTHING_DISCOVERY_PORT=21027

# Каталог на хосте с синхронизируемыми файлами.
# Укажите абсолютный путь, например /srv/syncthing.
# Host directory with the synchronised files.
# Use an absolute path, for example /srv/syncthing.
SYNCTHING_DATA_LOCATION=./data

# Docker volume с конфигурацией, ключами устройства и базой индексов.
# Docker volume with the configuration, device keys, and the index database.
SYNCTHING_CONFIG_VOLUME=syncthing-config

# UID и GID владельца файлов внутри контейнера.
# UID and GID that own the files inside the container.
SYNCTHING_UID=1000
SYNCTHING_GID=1000

# Часовой пояс в формате IANA, например Etc/UTC.
# IANA time zone, for example Etc/UTC.
TZ=Etc/UTC
